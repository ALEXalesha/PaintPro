<Window x:Class="PaintPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PaintPro.ViewModels"
        xmlns:views="clr-namespace:PaintPro.Views"
        xmlns:conv="clr-namespace:PaintPro.Converters"
        xmlns:models="clr-namespace:PaintPro.Models"
        Title="Paint Pro"
        Width="1380" Height="860"
        MinWidth="900" MinHeight="600"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <!-- Свой заголовок окна: системная полоса убрана, рамка Windows осталась - прилипание к
         краям, изменение размера за край, тень и скругление Windows 11 работают как раньше.
         Окно не прозрачное: прозрачное WPF рисует без видеокарты, и холст бы тормозил. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0,0,0,1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:ToolKindToBoolConverter x:Key="ToolToBool"/>

        <!-- Кнопки окна в цвет темы, как у калькуляторов: системная светлая полоса
             заголовка со своими кнопками бросалась в глаза на тёмном стекле. -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource GlassBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorder}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="14" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource GlassBgStrong}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Tag" Value="close"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bg" Property="Background" Value="#D9FF5050"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Global hotkeys — see antipattern #3: bound on Window so focus on buttons can't steal them. -->
    <Window.InputBindings>
        <KeyBinding Key="P"      Command="{Binding SelectToolCommand}" CommandParameter="Pencil"/>
        <KeyBinding Key="B"      Command="{Binding SelectToolCommand}" CommandParameter="Brush"/>
        <KeyBinding Key="M"      Command="{Binding SelectToolCommand}" CommandParameter="Marker"/>
        <KeyBinding Key="E"      Command="{Binding SelectToolCommand}" CommandParameter="Eraser"/>
        <KeyBinding Key="G"      Command="{Binding SelectToolCommand}" CommandParameter="Fill"/>
        <KeyBinding Key="I"      Command="{Binding SelectToolCommand}" CommandParameter="Picker"/>
        <KeyBinding Key="T"      Command="{Binding SelectToolCommand}" CommandParameter="Text"/>
        <KeyBinding Key="L"      Command="{Binding SelectToolCommand}" CommandParameter="Line"/>
        <KeyBinding Key="R"      Command="{Binding SelectToolCommand}" CommandParameter="Rect"/>
        <KeyBinding Key="O"      Command="{Binding SelectToolCommand}" CommandParameter="Ellipse"/>
        <KeyBinding Key="S"      Command="{Binding SelectToolCommand}" CommandParameter="Select"/>
        <KeyBinding Key="Q"      Command="{Binding SelectToolCommand}" CommandParameter="Quad"/>
        <KeyBinding Key="H"      Command="{Binding SelectToolCommand}" CommandParameter="Hand"/>
        <KeyBinding Key="C"      Command="{Binding SelectToolCommand}" CommandParameter="Crop"/>

        <KeyBinding Key="Z"      Modifiers="Ctrl" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y"      Modifiers="Ctrl" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="Z"      Modifiers="Ctrl+Shift" Command="{Binding RedoCommand}"/>

        <KeyBinding Key="S"      Modifiers="Ctrl" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="S"      Modifiers="Ctrl+Shift" Command="{Binding SaveAsCommand}"/>
        <KeyBinding Key="O"      Modifiers="Ctrl" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="N"      Modifiers="Ctrl" Command="{Binding NewDocumentCommand}"/>

        <KeyBinding Key="C"      Modifiers="Ctrl" Command="{Binding CopySelectionCommand}"/>
        <KeyBinding Key="X"      Modifiers="Ctrl" Command="{Binding CutSelectionCommand}"/>
        <KeyBinding Key="V"      Modifiers="Ctrl" Command="{Binding PasteCommand}"/>
        <KeyBinding Key="A"      Modifiers="Ctrl" Command="{Binding SelectAllCommand}"/>
        <KeyBinding Key="D"      Modifiers="Ctrl" Command="{Binding DeselectCommand}"/>

        <KeyBinding Key="Delete" Command="{Binding DeleteSelectionCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelFloatingCommand}"/>
        <KeyBinding Key="Enter"  Command="{Binding CommitFloatingCommand}"/>

        <!-- Поворот поднятого выделения: ±90°, с Shift ±15°. -->
        <KeyBinding Key="OemOpenBrackets"  Command="{Binding RotateFloatingCommand}" CommandParameter="-90"/>
        <KeyBinding Key="OemCloseBrackets" Command="{Binding RotateFloatingCommand}" CommandParameter="90"/>
        <KeyBinding Key="OemOpenBrackets"  Modifiers="Shift" Command="{Binding RotateFloatingCommand}" CommandParameter="-15"/>
        <KeyBinding Key="OemCloseBrackets" Modifiers="Shift" Command="{Binding RotateFloatingCommand}" CommandParameter="15"/>

        <KeyBinding Key="OemPlus"  Modifiers="Ctrl" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Key="Add"      Modifiers="Ctrl" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Key="OemMinus" Modifiers="Ctrl" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Key="Subtract" Modifiers="Ctrl" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Key="D0"       Modifiers="Ctrl" Command="{Binding ZoomResetCommand}"/>
        <KeyBinding Key="NumPad0"  Modifiers="Ctrl" Command="{Binding ZoomResetCommand}"/>
    </Window.InputBindings>

    <Grid AllowDrop="True" x:Name="RootGrid">
        <!-- Coloured glow blobs behind everything — gives Liquid Glass surfaces something to refract.
             Each blob has a drifting Storyboard on the compositor thread (not DispatcherTimer). -->
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Canvas.Resources>
                <!-- Reusable storyboard maker would be nicer; inlining for readability. -->
            </Canvas.Resources>
            <Ellipse Width="1100" Height="700" Canvas.Left="-180" Canvas.Top="-220" Opacity="0.55" RenderTransformOrigin="0.5,0.5" Fill="{DynamicResource Blob1}">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Blob1Move"/></Ellipse.RenderTransform>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetName="Blob1Move" Storyboard.TargetProperty="Y"
                                                 From="-30" To="60" Duration="0:0:18">
                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Blob1Move" Storyboard.TargetProperty="X"
                                                 From="0" To="40" Duration="0:0:22">
                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
            <Ellipse Width="900" Height="600" Canvas.Right="-100" Canvas.Top="50" Opacity="0.40" RenderTransformOrigin="0.5,0.5" Fill="{DynamicResource Blob2}">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Blob2Move"/></Ellipse.RenderTransform>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetName="Blob2Move" Storyboard.TargetProperty="Y"
                                                 From="0" To="-50" Duration="0:0:24">
                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Blob2Move" Storyboard.TargetProperty="X"
                                                 From="0" To="-30" Duration="0:0:19">
                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
            <Ellipse Width="800" Height="800" Canvas.Right="-200" Canvas.Bottom="-200" Opacity="0.40" RenderTransformOrigin="0.5,0.5" Fill="{DynamicResource Blob3}">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Blob3Move"/></Ellipse.RenderTransform>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetName="Blob3Move" Storyboard.TargetProperty="Y"
                                                 From="0" To="-40" Duration="0:0:26">
                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Blob3Move" Storyboard.TargetProperty="X"
                                                 From="0" To="40" Duration="0:0:30">
                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
            <Ellipse Width="700" Height="600" Canvas.Left="-100" Canvas.Bottom="-150" Opacity="0.30" RenderTransformOrigin="0.5,0.5" Fill="{DynamicResource Blob4}">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Blob4Move"/></Ellipse.RenderTransform>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetName="Blob4Move" Storyboard.TargetProperty="Y"
                                                 From="0" To="50" Duration="0:0:21">
                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Blob4Move" Storyboard.TargetProperty="X"
                                                 From="0" To="-30" Duration="0:0:28">
                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
        </Canvas>

        <DockPanel LastChildFill="True">

            <!-- ───── Заголовок окна: значок, название, меню и кнопки окна в одной полосе ───── -->
            <Grid DockPanel.Dock="Top" Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Image Source="pack://application:,,,/PaintPro;component/Assets/AppIcon.ico" Width="18" Height="18" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Paint Pro" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                </StackPanel>
            <Menu Grid.Column="1" Background="Transparent" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                <MenuItem Header="_Файл">
                    <MenuItem Header="Создать"   InputGestureText="Ctrl+N" Command="{Binding NewDocumentCommand}"/>
                    <MenuItem Header="Открыть…"  InputGestureText="Ctrl+O" Command="{Binding OpenCommand}"/>
                    <MenuItem Header="Сохранить" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}"/>
                    <MenuItem Header="Сохранить как…" InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsCommand}"/>
                    <Separator/>
                    <MenuItem Header="Выход" Click="OnExitClick"/>
                </MenuItem>
                <MenuItem Header="_Правка">
                    <MenuItem Header="Отменить" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}"/>
                    <MenuItem Header="Повторить" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}"/>
                    <Separator/>
                    <MenuItem Header="Вырезать" InputGestureText="Ctrl+X" Command="{Binding CutSelectionCommand}"/>
                    <MenuItem Header="Копировать" InputGestureText="Ctrl+C" Command="{Binding CopySelectionCommand}"/>
                    <MenuItem Header="Вставить"  InputGestureText="Ctrl+V" Command="{Binding PasteCommand}"/>
                    <MenuItem Header="Удалить"   InputGestureText="Delete" Command="{Binding DeleteSelectionCommand}"/>
                    <MenuItem Header="Выделить всё" InputGestureText="Ctrl+A" Command="{Binding SelectAllCommand}"/>
                    <MenuItem Header="Снять выделение" InputGestureText="Ctrl+D" Command="{Binding DeselectCommand}"/>
                </MenuItem>
                <MenuItem Header="_Вид">
                    <!-- Список тем собирается кодом: он один на меню и на проверки,
                         и добавить тему - значит добавить строку в ThemeService.All. -->
                    <MenuItem Header="Тема" x:Name="ThemeMenu"/>
                    <Separator/>
                    <MenuItem Header="Увеличить"  InputGestureText="Ctrl+=" Command="{Binding ZoomInCommand}"/>
                    <MenuItem Header="Уменьшить" InputGestureText="Ctrl+-" Command="{Binding ZoomOutCommand}"/>
                    <MenuItem Header="Сбросить масштаб" InputGestureText="Ctrl+0" Command="{Binding ZoomResetCommand}"/>
                </MenuItem>
                <MenuItem Header="_Изображение">
                    <MenuItem Header="Изменить размер холста…" Command="{Binding ResizeCanvasCommand}"/>
                    <MenuItem Header="Повернуть 90° по часовой"   Command="{Binding Rotate90Command}"/>
                    <MenuItem Header="Повернуть 90° против часовой" Command="{Binding RotateMinus90Command}"/>
                    <MenuItem Header="Отразить горизонтально" Command="{Binding FlipHorizontalCommand}"/>
                    <MenuItem Header="Отразить вертикально"   Command="{Binding FlipVerticalCommand}"/>
                </MenuItem>
                <MenuItem Header="_Справка">
                    <MenuItem Header="О программе" Click="OnAboutClick"/>
                </MenuItem>
            </Menu>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button Style="{StaticResource CaptionButton}" ToolTip="Свернуть" Click="OnMinimizeClick">
                        <Path Data="M0,0 L10,0" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.4" Width="10" Height="1.4" Stretch="Fill"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" ToolTip="Развернуть" Click="OnMaximizeClick">
                        <Path x:Name="MaximizeGlyph" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.3" Width="10" Height="10"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Tag="close" ToolTip="Закрыть" Click="OnCloseClick">
                        <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.4" Width="9" Height="9"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ───── Status bar (bottom) ───── -->
            <Border DockPanel.Dock="Bottom" Style="{DynamicResource GlassPanel}" Margin="8,4,8,8" Padding="14,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock x:Name="StatusPos" Text="—" Foreground="{DynamicResource TextDim}"/>
                        <!-- Объяснение, почему жест ничего не сделал: скрытый слой и подобное.
                             Пустая строка прячет всю строку целиком. -->
                        <TextBlock Text="{Binding StatusHint}" Margin="16,0,0,0"
                                   Foreground="{DynamicResource Accent}"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusHint}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="12,0">
                        <!-- Цвет точки под курсором: и квадрат, и подпись. Раньше квадрат
                             показывал цвет кисти, а подпись - точку под курсором, и рядом
                             стояли два разных цвета. -->
                        <Border x:Name="StatusSwatch" Width="14" Height="14" CornerRadius="3"
                                BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1"
                                Background="Transparent" Visibility="Hidden"/>
                        <TextBlock x:Name="StatusHex" Text="" Margin="6,0,0,0" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Margin="12,0"
                               Text="{Binding Zoom, StringFormat={}{0:P0}}"
                               Foreground="{DynamicResource TextDim}"/>
                    <TextBlock Grid.Column="3" Margin="12,0"
                               Text="{Binding VersionLabel}"
                               Foreground="{DynamicResource TextDim}"/>
                </Grid>
            </Border>

            <!-- ───── Left toolbar ───── -->
            <Border DockPanel.Dock="Left" Style="{DynamicResource GlassPanel}" Padding="6" Width="142">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <!-- Инструменты по группам, по два в ряд: с подписями в одну колонку все 19
                         не помещались по высоте, и нижние уезжали под прокрутку. -->
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Drawing tools -->
                        <UniformGrid Columns="2">
                        <ToggleButton Style="{DynamicResource ToolButton}" ToolTip="Карандаш (P)"
                                IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter=Pencil, Mode=OneWay}"
                                Click="OnToolClick" Tag="Pencil" AutomationProperties.Name="Карандаш">
                            <Path Style="{DynamicResource ToolGlyph}" Data="{DynamicResource Icon.Pencil}"/>
                        </ToggleButton>
                        <ToggleButton Style="{DynamicResource ToolButton}" ToolTip="Кисть (B)"
                                IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter=Brush, Mode=OneWay}"
                                Click="OnToolClick" Tag="Brush" AutomationProperties.Name="Кисть">
                            <Path Style="{DynamicResource ToolGlyph}" Data="{DynamicResource Icon.Brush}"/>
                        </ToggleButton>
                        <ToggleButton Style="{DynamicResource ToolButton}" ToolTip="Маркер (M)"
                                IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter=Marker, Mode=OneWay}"
                                Click="OnToolClick" Tag="Marker" AutomationProperties.Name="Маркер">
                            <Path Style="{DynamicResource ToolGlyph}" Data="{DynamicResource Icon.Marker}"/>
                        </ToggleButton>
                        <ToggleButton Style="{DynamicResource ToolButton}" ToolTip="Ластик (E)"
                                IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter=Eraser, Mode=OneWay}"
                                Click="OnToolClick" Tag="Eraser" AutomationProperties.Name="Ластик">
                            <Path Style="{DynamicResource ToolGlyph}" Data="{DynamicResource Icon.Eraser}"/>
                        </ToggleButton>
                        <ToggleButton Style="{DynamicResource ToolButton}" ToolTip="Заливка (G)"
                                IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter=Fill, Mode=OneWay}"
                                Click="OnToolClick" Tag="Fill" AutomationProperties.Name="Заливка">
                            <Path Style="{DynamicResource ToolGlyph}" Data="{DynamicResource Icon.Fill}"/>
                        </ToggleButton>
                        <ToggleButton Style="{DynamicResource ToolButton}" ToolTip="Пипетка (I)"
                                IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter=Picker, Mode=OneWay}"
                                Click="OnToolClick" Tag="Picker" AutomationProperties.Name="Пипетка">
                            <Path Style="{DynamicResource ToolGlyph}" Data="{DynamicResource Icon.Picker}"/>
                        </ToggleButton>
                        <ToggleButton Style="{DynamicResource ToolButton}" ToolTip="Текст (T)"
                                IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter=Text, Mode=OneWay}"
                                Click="OnToolClick" Tag="Text" AutomationProperties.Name="Текст">
                            <Path Style="{DynamicResource ToolGlyph}" Data="{DynamicResource Icon.Text}"/>
                        </ToggleButton>

                        </UniformGrid>
                        <Rectangle Height="1" Fill="{DynamicResource GlassBorder}" Margin="6,8" />
                        <UniformGrid Columns="2">

                        <!-- Shape tools -->
                        <ToggleButton Style="{DynamicResource ToolButton}" ToolTip="Линия (L)"
                                IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter=Line, Mode=OneWay}"
                                Click="OnToolClick" Tag="Line" AutomationProperties.Name="Линия">
                            <Path Style="{DynamicResource ToolGlyph}" Data="{DynamicResource Icon.Line}" Fill="Transparent" Stroke="{DynamicResource TextPrimary}" StrokeThickness="2"/>
                        </ToggleButton>
                        <ToggleButton Style="{DynamicResource ToolButton}" ToolTip="Прямоугольник (R)"
                                IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter=Rect, Mode=OneWay}"
                                Click="OnToolClick" Tag="Rect" AutomationProperties.Name="Прямоуг.">
                            <Path Style="{DynamicResource ToolGlyph}" Data="{DynamicResource Icon.Rect}" Fill="Transparent" Stroke="{DynamicResource TextPrimary}" StrokeThickness="2"/>
                        </ToggleButton>
                        <ToggleButton Style="{DynamicResource ToolButton}" ToolTip="Эллипс (O)"
                                IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter=Ellipse, Mode=OneWay}"
                                Click="OnToolClick" Tag="Ellipse" AutomationProperties.Name="Эллипс">
                            <Path Style="{DynamicResource ToolGlyph}" Data="{DynamicResource Icon.Ellipse}" Fill="Transparent" Stroke="{DynamicResource TextPrimary}" StrokeThickness="2"/>
                        </ToggleButton>
                        <ToggleButton Style="{DynamicResource ToolButton}" ToolTip="Треугольник"
                                IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter=Triangle, Mode=OneWay}"
                                Click="OnToolClick" Tag="Triangle" AutomationProperties.Name="Треуг.">
                            <Path Style="{DynamicResource ToolGlyph}" Data="{DynamicResource Icon.Triangle}" Fill="Transparent" Stroke="{DynamicResource TextPrimary}" StrokeThickness="2"/>
                        </ToggleButton>
                        <ToggleButton Style="{DynamicResource ToolButton}" ToolTip="Прямоугольный треугольник"
                                IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter=RightTriangle, Mode=OneWay}"
                                Click="OnToolClick" Tag="RightTriangle" AutomationProperties.Name="Прям. угол">
                            <Path Style="{DynamicResource ToolGlyph}" Data="{DynamicResource Icon.RightTriangle}" Fill="Transparent" Stroke="{DynamicResource TextPrimary}" StrokeThickness="2"/>
                        </ToggleButton>
                        <ToggleButton Style="{DynamicResource ToolButton}" ToolTip="Звезда"
                                IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter=Star, Mode=OneWay}"
                                Click="OnToolClick" Tag="Star" AutomationProperties.Name="Звезда">
                            <Path Style="{DynamicResource ToolGlyph}" Data="{DynamicResource Icon.Star}"/>
                        </ToggleButton>
                        <ToggleButton Style="{DynamicResource ToolButton}" ToolTip="Стрелка"
                                IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter=Arrow, Mode=OneWay}"
                                Click="OnToolClick" Tag="Arrow" AutomationProperties.Name="Стрелка">
                            <Path Style="{DynamicResource ToolGlyph}" Data="{DynamicResource Icon.Arrow}" Fill="Transparent" Stroke="{DynamicResource TextPrimary}" StrokeThickness="2"/>
                        </ToggleButton>
                        <ToggleButton Style="{DynamicResource ToolButton}" ToolTip="Сердце"
                                IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter=Heart, Mode=OneWay}"
                                Click="OnToolClick" Tag="Heart" AutomationProperties.Name="Сердце">
                            <Path Style="{DynamicResource ToolGlyph}" Data="{DynamicResource Icon.Heart}" Fill="Transparent" Stroke="{DynamicResource TextPrimary}" StrokeThickness="2"/>
                        </ToggleButton>

                        </UniformGrid>
                        <Rectangle Height="1" Fill="{DynamicResource GlassBorder}" Margin="6,8"/>
                        <UniformGrid Columns="2">

                        <!-- Selection / navigation -->
                        <ToggleButton Style="{DynamicResource ToolButton}" ToolTip="Прямоугольное выделение (S)"
                                IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter=Select, Mode=OneWay}"
                                Click="OnToolClick" Tag="Select" AutomationProperties.Name="Выделение">
                            <Path Style="{DynamicResource ToolGlyph}" Data="{DynamicResource Icon.Select}"/>
                        </ToggleButton>
                        <ToggleButton Style="{DynamicResource ToolButton}" ToolTip="Полигон-выделение (Q)"
                                IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter=Quad, Mode=OneWay}"
                                Click="OnToolClick" Tag="Quad" AutomationProperties.Name="Полигон">
                            <Path Style="{DynamicResource ToolGlyph}" Data="{DynamicResource Icon.Quad}" Fill="Transparent" Stroke="{DynamicResource TextPrimary}" StrokeThickness="2"/>
                        </ToggleButton>
                        <ToggleButton Style="{DynamicResource ToolButton}" ToolTip="Кадрирование (C)"
                                IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter=Crop, Mode=OneWay}"
                                Click="OnToolClick" Tag="Crop" AutomationProperties.Name="Обрезка">
                            <Path Style="{DynamicResource ToolGlyph}" Data="{DynamicResource Icon.Crop}"/>
                        </ToggleButton>
                        <ToggleButton Style="{DynamicResource ToolButton}" ToolTip="Рука / панорама (H)"
                                IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter=Hand, Mode=OneWay}"
                                Click="OnToolClick" Tag="Hand" AutomationProperties.Name="Рука">
                            <Path Style="{DynamicResource ToolGlyph}" Data="{DynamicResource Icon.Hand}"/>
                        </ToggleButton>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ───── Right side panel: color, size, opacity, layers, quick actions ───── -->
            <Border DockPanel.Dock="Right" Style="{DynamicResource GlassPanel}" Width="290" Padding="14,14,6,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <!-- Отступ до полосы прокрутки: значения справа («12 px») упирались в неё. -->
                    <StackPanel Margin="0,0,10,0">
                        <!-- Active colour preview + custom picker -->
                        <TextBlock Text="ЦВЕТ" FontSize="11" Opacity="0.6" Margin="0,0,0,6"/>
                        <Border CornerRadius="10" Height="40"
                                BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1"
                                Background="{Binding PrimaryColorBrush}"
                                MouseLeftButtonDown="OnPickCustomColorClick"
                                Cursor="Hand"
                                Margin="0,0,0,8"/>

                        <!-- Палитра ровной сеткой по центру панели: в WrapPanel квадраты
                             прижимались влево, и справа оставался пустой зазор. -->
                        <ItemsControl ItemsSource="{Binding Palette}" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="9"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{DynamicResource ColorSwatch}"
                                            Background="{Binding Brush}"
                                            Click="OnPaletteClick" Tag="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="ПОСЛЕДНИЕ" FontSize="11" Opacity="0.6" Margin="0,12,0,4"/>
                        <ItemsControl ItemsSource="{Binding RecentColors}" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="9" Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{DynamicResource ColorSwatch}"
                                            Background="{Binding Brush}"
                                            Click="OnPaletteClick" Tag="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Rectangle Height="1" Fill="{DynamicResource GlassBorder}" Margin="0,14"/>

                        <!-- Подпись слева, значение справа, ползунок под ними во всю ширину:
                             значение под ползунком стояло отдельной строкой не по краю. -->
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ToolSize, StringFormat={}{0} px}" FontSize="12" Opacity="0.85"/>
                            <TextBlock Text="РАЗМЕР" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider Style="{DynamicResource GlassSlider}"
                                Minimum="{Binding ToolSizeMin, Mode=OneTime}"
                                Maximum="{Binding ToolSizeMax, Mode=OneTime}"
                                Value="{Binding ToolSize}" TickFrequency="1" IsSnapToTickEnabled="True"/>

                        <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Opacity, StringFormat={}{0:P0}}" FontSize="12" Opacity="0.85"/>
                            <TextBlock Text="ПРОЗРАЧНОСТЬ" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider Style="{DynamicResource GlassSlider}" Minimum="0" Maximum="1"
                                Value="{Binding Opacity}" SmallChange="0.05" LargeChange="0.1"/>

                        <CheckBox Margin="0,10,0,0"
                                  IsChecked="{Binding ShapeFill, Mode=TwoWay}"
                                  Foreground="{DynamicResource TextPrimary}"
                                  Content="Заливать фигуры"
                                  ToolTip="Прямоугольник, эллипс, треугольник, звезда, сердце"/>

                        <Rectangle Height="1" Fill="{DynamicResource GlassBorder}" Margin="0,14"/>

                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" FontSize="12" Opacity="0.85">
                                <Run Text="{Binding Document.CanvasWidth, Mode=OneWay}"/><Run Text=" × "/><Run Text="{Binding Document.CanvasHeight, Mode=OneWay}"/><Run Text=" px"/>
                            </TextBlock>
                            <TextBlock Text="ХОЛСТ" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Button Style="{DynamicResource GhostButton}" Margin="0,6,0,0"
                                Content="Изменить размер…" Command="{Binding ResizeCanvasCommand}"/>

                        <Rectangle Height="1" Fill="{DynamicResource GlassBorder}" Margin="0,14"/>

                        <TextBlock Text="БЫСТРЫЕ ДЕЙСТВИЯ" FontSize="11" Opacity="0.6"/>
                        <UniformGrid Columns="2" Margin="-3,4,-3,0">
                            <Button Style="{DynamicResource GhostButton}" Content="↻ 90°" ToolTip="Повернуть по часовой" Command="{Binding Rotate90Command}"/>
                            <Button Style="{DynamicResource GhostButton}" Content="↺ 90°" ToolTip="Повернуть против часовой" Command="{Binding RotateMinus90Command}"/>
                            <Button Style="{DynamicResource GhostButton}" Content="↔ Отразить" ToolTip="Отразить по горизонтали" Command="{Binding FlipHorizontalCommand}"/>
                            <Button Style="{DynamicResource GhostButton}" Content="↕ Отразить" ToolTip="Отразить по вертикали" Command="{Binding FlipVerticalCommand}"/>
                        </UniformGrid>

                        <Rectangle Height="1" Fill="{DynamicResource GlassBorder}" Margin="0,14"/>

                        <!-- Layer panel -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="СЛОИ" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Style="{DynamicResource GhostButton}"
                                    Content="+ слой" Padding="6,2" FontSize="11"
                                    Command="{Binding AddLayerCommand}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding LayerItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,2" Padding="6" CornerRadius="8"
                                            BorderThickness="1" BorderBrush="{DynamicResource GlassBorder}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource GlassBg}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource GlassBgStrong}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding Visible, Mode=TwoWay}"
                                                      VerticalAlignment="Center" Margin="0,0,8,0"
                                                      Foreground="{DynamicResource TextPrimary}"
                                                      ToolTip="Видимость"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}"
                                                           MouseLeftButtonDown="OnLayerNameClick" Cursor="Hand"/>
                                                <Slider Minimum="0" Maximum="1" Value="{Binding Opacity, Mode=TwoWay}"
                                                        Style="{DynamicResource GlassSlider}" Height="16"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{DynamicResource GhostButton}"
                                                    Content="×" FontSize="14" Padding="4,0"
                                                    Click="OnLayerDeleteClick" Tag="{Binding}"
                                                    ToolTip="Удалить слой"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Rectangle Height="1" Fill="{DynamicResource GlassBorder}" Margin="0,14"/>

                        <!-- Expandable change history: click any row to roll back/forward to it -->
                        <Expander IsExpanded="True" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4">
                            <Expander.Header>
                                <TextBlock Text="ИСТОРИЯ ИЗМЕНЕНИЙ" FontSize="11" Opacity="0.6"/>
                            </Expander.Header>
                            <Border Margin="0,6,0,0" CornerRadius="8" Padding="2"
                                    Background="{DynamicResource GlassBg}"
                                    BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1">
                                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding HistoryItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                              <Grid ToolTip="{Binding ToggleHint}">
                                                <Grid.ColumnDefinitions>
                                                    <!-- Ширина колонки постоянная: у строк без
                                                         выключателя подписи обязаны стоять там же. -->
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!--
                                                  Выключатель правки. Снятая галочка убирает её из
                                                  картинки, не трогая те, что идут после, - в отличие
                                                  от щелчка по строке, который откатывает всё после
                                                  неё. Есть он не у всех: правку, записывающую
                                                  картинку целиком, пропустить нельзя, и ту, ниже
                                                  которой такая есть, - тоже (HistoryManager.CanToggle).
                                                  Привязка ОДНОСТОРОННЯЯ, переключает команда: в ответ
                                                  на неё лента пересобирает строки, и запись обратно в
                                                  уже выброшенный объект была бы записью в никуда.
                                                -->
                                                <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                                          Margin="4,0,0,0" Focusable="False"
                                                          IsChecked="{Binding Enabled, Mode=OneWay}"
                                                          Foreground="{DynamicResource TextPrimary}"
                                                          Command="{Binding DataContext.ToggleHistoryEntryCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}">
                                                    <CheckBox.Style>
                                                        <Style TargetType="CheckBox">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanToggle}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </CheckBox.Style>
                                                </CheckBox>
                                                <Button Grid.Column="1"
                                                        HorizontalContentAlignment="Left"
                                                        Padding="8,4" Margin="0,1" Cursor="Hand"
                                                        BorderThickness="0" FontSize="12"
                                                        Foreground="{DynamicResource TextPrimary}"
                                                        Command="{Binding DataContext.JumpToHistoryCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" CornerRadius="6"
                                                                    Background="Transparent"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassBgStrong}"/>
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsFuture}" Value="True">
                                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <!-- Выключенная правка видна как
                                                                         зачёркнутая: она осталась в
                                                                         ленте, но в картинку не идёт. -->
                                                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                        <Setter Property="Opacity" Value="0.5"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>
                                              </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Expander>

                        <Rectangle Height="1" Fill="{DynamicResource GlassBorder}" Margin="0,14"/>

                        <UniformGrid Columns="3" Margin="-3,0">
                            <Button Style="{DynamicResource GhostButton}" Content="−" Command="{Binding ZoomOutCommand}"/>
                            <Button Style="{DynamicResource GhostButton}" Content="1:1" Command="{Binding ZoomResetCommand}"/>
                            <Button Style="{DynamicResource GhostButton}" Content="+" Command="{Binding ZoomInCommand}"/>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ───── Centre canvas ───── -->
            <Border Style="{DynamicResource GlassPanel}" Padding="0">
                <views:CanvasView x:Name="Canvas" />
            </Border>
        </DockPanel>
    </Grid>
</Window>
