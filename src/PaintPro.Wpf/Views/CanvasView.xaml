<UserControl x:Class="PaintPro.Views.CanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
             Background="Transparent"
             Focusable="False"
             ClipToBounds="True">
    <Grid x:Name="Root">
        <ScrollViewer x:Name="Scroll"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="Transparent">
            <!-- Холст, который меньше окна, стоит посередине по ширине и у верхнего края, как
                 в Electron-версии (там justify-content: safe center). Было Left: уменьшенный
                 холст съезжал в левый верхний угол. Когда холст шире окна, ScrollViewer
                 отдаёт ему ровно его ширину, и выравнивать уже нечего - прокрутка та же. -->
            <Grid x:Name="ContentRoot"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top">
                <!-- Тени под холстом. Лежат в своём кэше: холст перерисовывается каждый кадр,
                     пока по нему рисуют, а тени от этого не меняются, и размывать их заново
                     незачем. До 1.29.0 размытие шло на каждом кадре и было главной причиной
                     медленного рисования. Разрешение кэша ставит CanvasView (не больше
                     ShadowCacheSide по длинной стороне): под холстом с восьмикратным увеличением
                     кэш во всю величину занял бы сотни мегабайт, а размытой тени хватает и
                     меньшего. Видна от них только тень - сами подложки закрыты холстом. -->
                <Grid x:Name="CanvasShadow"
                      IsHitTestVisible="False"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top">
                    <Grid.CacheMode>
                        <BitmapCache SnapsToDevicePixels="True"/>
                    </Grid.CacheMode>
                    <!-- Тень со сдвигом вниз. До 1.29.0 её давала панель вокруг холста. -->
                    <Border x:Name="CanvasDropShadow"
                            Background="#181425"
                            CornerRadius="4">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.35" Color="Black"/>
                        </Border.Effect>
                    </Border>
                    <Border x:Name="CanvasFrame"
                            Background="#181425"
                            BorderBrush="{DynamicResource GlassBorder}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="32" ShadowDepth="0" Opacity="0.6" Color="Black"/>
                        </Border.Effect>
                    </Border>
                </Grid>
                <!-- Поверхность холста: размером с документ, умноженный на масштаб. Сама ничего
                     не рисует - ловит мышь и задаёт координаты (пиксель документа = точка
                     поверхности / масштаб). Прозрачный фон нужен, чтобы попадание мыши
                     считалось по всей площади. -->
                <Border x:Name="Surface"
                        Background="Transparent"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"/>
                <!-- Растр - только видимая часть поверхности, не больше окна просмотра
                     (1.30.0). До того SKElement был во всю поверхность: фотография 4000x3000
                     каждый кадр целиком собиралась и целиком уезжала в видеокарту, хотя
                     видна была восьмая её часть. Место и размер растру ставит CanvasView
                     (PlaceRaster) при каждой прокрутке и смене масштаба. Мышь он не ловит:
                     её ловит Surface под ним. -->
                <skia:SKElement x:Name="Raster"
                                IgnorePixelScaling="False"
                                IsHitTestVisible="False"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"/>
                <!-- WPF overlay for selection-frame + drag handles. Lives at the same scale
                     as the Surface; coordinates are document pixels × Zoom.
                     CRITICAL: Background="{x:Null}" so empty overlay areas pass mouse
                     events through to Surface below. Child handles with non-null Fill
                     remain hit-testable in their own bounds. -->
                <Canvas x:Name="Overlay"
                        Background="{x:Null}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"/>
                <!-- Кружок размера кисти (1.32.0): диаметр - толщина инструмента на экране,
                     центр - под курсором. Отдельный слой, а не Overlay: тот пересобирается
                     каждый кадр, а кружок двигается на каждое движение мыши. Мышь не ловит. -->
                <Canvas x:Name="RingLayer"
                        IsHitTestVisible="False"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                    <Ellipse x:Name="BrushRingOuter" Stroke="#E6FFFFFF" StrokeThickness="3" Visibility="Collapsed"/>
                    <Ellipse x:Name="BrushRing" Stroke="Black" StrokeThickness="1" Visibility="Collapsed"/>
                    <!-- Крестик большого кружка: системный указатель над ним спрятан, чтобы
                         кружок и крестик двигались вместе (см. RingCursor). -->
                    <Path x:Name="BrushCrossOuter" Data="M-5,0 H5 M0,-5 V5" Stroke="#E6FFFFFF" StrokeThickness="3" Visibility="Collapsed"/>
                    <Path x:Name="BrushCross" Data="M-5,0 H5 M0,-5 V5" Stroke="Black" StrokeThickness="1" Visibility="Collapsed"/>
                </Canvas>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
