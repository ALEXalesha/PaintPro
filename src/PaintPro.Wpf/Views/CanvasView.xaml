<UserControl x:Class="PaintPro.Views.CanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
             Background="Transparent"
             Focusable="False"
             ClipToBounds="True">
    <Grid x:Name="Root">
        <ScrollViewer x:Name="Scroll"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="Transparent">
            <Grid x:Name="ContentRoot"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top">
                <!-- Drop shadow & checkered alpha background behind the canvas. -->
                <Border x:Name="CanvasFrame"
                        Background="#181425"
                        BorderBrush="{DynamicResource GlassBorder}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="32" ShadowDepth="0" Opacity="0.6" Color="Black"/>
                    </Border.Effect>
                </Border>
                <!-- SkiaSharp viewport — renders the entire document (all layers + floating pickup). -->
                <skia:SKElement x:Name="Skia"
                                IgnorePixelScaling="False"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"/>
                <!-- WPF overlay for selection-frame + drag handles. Lives at the same scale
                     as the SKElement; coordinates are document pixels × Zoom.
                     CRITICAL: Background="{x:Null}" so empty overlay areas pass mouse
                     events through to SKElement below. Child handles with non-null Fill
                     remain hit-testable in their own bounds. -->
                <Canvas x:Name="Overlay"
                        Background="{x:Null}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
