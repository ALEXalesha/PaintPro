<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>PaintPro</RootNamespace>
    <AssemblyName>PaintPro</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <!-- Single-file publish settings (used by `dotnet publish`). -->
    <PublishSingleFile Condition="'$(PublishSingleFile)' == ''">false</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <AssemblyTitle>Paint Pro</AssemblyTitle>
    <Product>Paint Pro</Product>
    <Company>Paint Pro</Company>
    <Copyright>Paint Pro</Copyright>
    <Version>1.4.0</Version>
    <FileVersion>1.2.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Skia rendering engine (same as Chrome). -->
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.Views.WPF" Version="2.88.9" />

    <!-- Acrylic / Mica glass effects (Liquid Glass aesthetic). -->
    <PackageReference Include="WPF-UI" Version="3.0.5" />

    <!-- ObservableObject + [ObservableProperty] + [RelayCommand] source generators. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />

  </ItemGroup>

</Project>
