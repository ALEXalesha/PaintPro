<Application x:Class="PaintPro.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Первый словарь - ТЕМА. Её подменяет ThemeService на ходу; порядок важен,
                     потому что подмена идёт по индексу 0. -->
                <ResourceDictionary Source="Resources/Themes/Glass.xaml"/>
                <ResourceDictionary Source="Resources/GlassStyles.xaml"/>
                <ResourceDictionary Source="Resources/ToolIcons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
