<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand accent colours from REWRITE_PROMPT_CSHARP.md §"Цветовые токены". -->
    <SolidColorBrush x:Key="Accent"          Color="#5B8DEF"/>
    <SolidColorBrush x:Key="Accent2"         Color="#9D5BEF"/>

    <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#5B8DEF"/>
        <GradientStop Offset="1" Color="#9D5BEF"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TextPrimary"     Color="#F4F4F8"/>
    <SolidColorBrush x:Key="TextDim"         Color="#9EA0AE"/>
    <!--
      Фон выпадающего меню. Непрозрачный и свой: пока список рисовала система своим
      светлым фоном, наш светлый текст пропадал на нём начисто - меню открывалось пустой
      панелью. Пункты при этом были на месте и нажимались. Найдено только запуском
      приложения; ни один тест такого не ловит.
    -->
    <SolidColorBrush x:Key="MenuBg"          Color="#241C3A"/>

    <!-- Glass surfaces: translucent overlays placed atop the coloured window background. -->
    <SolidColorBrush x:Key="GlassBg"         Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="GlassBgStrong"   Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="GlassBgHover"    Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="GlassBorder"     Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="GlassBorderStrong" Color="#55FFFFFF"/>

    <!-- Base window background — dark indigo/violet gradient. The coloured blobs are added
         on top via overlapping Ellipses (see MainWindow). -->
    <LinearGradientBrush x:Key="WindowBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"   Color="#0E0C1A"/>
        <GradientStop Offset="0.5" Color="#1A1330"/>
        <GradientStop Offset="1"   Color="#0C1024"/>
    </LinearGradientBrush>
</ResourceDictionary>
