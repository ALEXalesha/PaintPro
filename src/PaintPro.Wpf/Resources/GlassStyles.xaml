<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Glass panel = translucent rounded rectangle with subtle border and drop shadow. -->
    <Style x:Key="GlassPanel" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource GlassBg}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource GlassBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="18"/>
        <Setter Property="Margin"          Value="8"/>
        <Setter Property="Padding"         Value="10"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.35" Color="Black"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small ghost button used across toolbars. -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Background"  Value="Transparent"/>
        <Setter Property="Foreground"  Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Cursor"  Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource GlassBgHover}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource GlassBgStrong}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tool button = 44×44 square in the left toolbar. Click toggles ActiveTool. -->
    <Style x:Key="ToolButton" TargetType="ToggleButton">
        <Setter Property="Background"  Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground"  Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Width"  Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource GlassBgHover}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentGrad}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource GlassBorderStrong}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Colour swatch square in palette + recent rows. -->
    <Style x:Key="ColorSwatch" TargetType="Button">
        <Setter Property="Width"  Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
        <Setter Property="Cursor"      Value="Hand"/>
        <Setter Property="Focusable"   Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider with thin glass track. -->
    <Style x:Key="GlassSlider" TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        <Setter Property="Background" Value="{StaticResource GlassBg}"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style TargetType="Menu">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
    <!--
      Меню рисуется своими шаблонами, а не системными.

      Пока список рисовала тема Windows, он приходил со своим светлым фоном, и наш светлый
      текст пропадал на нём начисто: меню открывалось пустой панелью, пункты были на месте
      и нажимались, но прочесть их было нельзя. Покрасить текст в тёмный не помогло:
      сквозной стиль TextBlock задаёт цвет НАСТАВЛЕНИЕМ, а оно сильнее наследования, и до
      подписи внутри пункта наш цвет не доходил вовсе. Проще и надёжнее оказалось забрать
      отрисовку целиком - заодно меню стало похоже на остальную программу.
    -->
    <ControlTemplate x:Key="MenuTopLevelTemplate" TargetType="MenuItem">
        <Grid>
            <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="10,4">
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
            </Border>
            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                   IsOpen="{TemplateBinding IsSubmenuOpen}" Focusable="False"
                   PopupAnimation="Fade" HorizontalOffset="-4">
                <Border Background="{StaticResource MenuBg}"
                        BorderBrush="{StaticResource GlassBorder}" BorderThickness="1"
                        CornerRadius="10" Padding="4" Margin="0,4,10,10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.55" Color="Black"/>
                    </Border.Effect>
                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource GlassBgStrong}"/>
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource GlassBgStrong}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="MenuSubItemTemplate" TargetType="MenuItem">
        <Border x:Name="bd" Background="Transparent" CornerRadius="6"
                Padding="12,6" Margin="0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0" ContentSource="Header"
                                  RecognizesAccessKey="True" VerticalAlignment="Center"/>
                <!-- Подсказка про хоткей: тусклее подписи, но на том же тёмном фоне. -->
                <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}"
                           Margin="28,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextDim}"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource GlassBgStrong}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <!-- Роль - единственное, что отличает заголовок в строке меню от пункта внутри списка. -->
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{StaticResource MenuTopLevelTemplate}"/>
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource MenuSubItemTemplate}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
      Всплывающая подсказка - та же беда, что была у меню, и по той же причине: система
      рисует её своим светлым фоном, а сквозной стиль TextBlock задаёт светлый текст
      наставлением, которое сильнее наследования. Подсказки у кнопок инструментов
      («Карандаш (P)») и у строк истории выходили пустой белой полосой. Забираем отрисовку
      себе - тогда и фон, и текст наши.
    -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource MenuBg}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="MaxWidth" Value="360"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.5" Color="Black"/>
                        </Border.Effect>
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <!-- Длинные объяснения переносятся, а не уезжают за край. -->
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    <Setter Property="FontFamily" Value="Segoe UI"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Разделитель внутри меню: на тёмном фоне системный не виден. -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="10,5"/>
        <Setter Property="Background" Value="{StaticResource GlassBorder}"/>
    </Style>
</ResourceDictionary>
