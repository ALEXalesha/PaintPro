<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      «Строгая» - без цветных пятен, приглушённый синий, ровный тёмный фон.

      Тема - это НАБОР ТЕХ ЖЕ КЛЮЧЕЙ. Всё оформление ходит через них, поэтому смена темы
      сводится к подмене этого словаря; ключи обязаны совпадать во всех темах до одного,
      иначе на смене приложение останется без кисти и упадёт при первой же отрисовке.

      Обращаться к ним надо через DynamicResource: StaticResource разрешается один раз
      при загрузке и подмену словаря не заметит.

      Отдельно стоят Overlay* - подложка того, что всплывает НАД ХОЛСТОМ (подсказки,
      выпадающие списки). Холст белый в любой теме, поэтому такая подложка в любой теме
      тёмная. Стеклянные кисти сюда не годятся: над белым они белеют, и светлый текст на
      них пропадает начисто - это уже случалось с выпадающим меню (1.23.0).
    -->

    <SolidColorBrush x:Key="Accent"            Color="#4A7AB8"/>
    <SolidColorBrush x:Key="Accent2"           Color="#5C7FA6"/>

    <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#4A7AB8"/>
        <GradientStop Offset="1" Color="#5C7FA6"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TextPrimary"       Color="#E6E8EC"/>
    <SolidColorBrush x:Key="TextDim"           Color="#9BA0AA"/>
    <SolidColorBrush x:Key="MenuBg"            Color="#232833"/>

    <!-- Подложка над холстом и её текст: темам не подчиняются по смыслу, см. оговорку выше. -->
    <SolidColorBrush x:Key="OverlayBg"         Color="#F21A142C"/>
    <SolidColorBrush x:Key="OverlayText"       Color="#F4F4F8"/>

    <!-- Опорный цвет фона: сплошной, под градиентом. По нему меряется контраст текста. -->
    <SolidColorBrush x:Key="AppBase"           Color="#1F242E"/>

    <SolidColorBrush x:Key="GlassBg"           Color="#0EFFFFFF"/>
    <SolidColorBrush x:Key="GlassBgStrong"     Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="GlassBgHover"      Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="GlassBorder"       Color="#1CFFFFFF"/>
    <SolidColorBrush x:Key="GlassBorderStrong" Color="#38FFFFFF"/>

    <!-- В этой теме цветных пятен нет: кисть прозрачная, эллипсы остаются
         на месте и ничего не рисуют. -->
    <SolidColorBrush x:Key="Blob1" Color="Transparent"/>
    <!-- В этой теме цветных пятен нет: кисть прозрачная, эллипсы остаются
         на месте и ничего не рисуют. -->
    <SolidColorBrush x:Key="Blob2" Color="Transparent"/>
    <!-- В этой теме цветных пятен нет: кисть прозрачная, эллипсы остаются
         на месте и ничего не рисуют. -->
    <SolidColorBrush x:Key="Blob3" Color="Transparent"/>
    <!-- В этой теме цветных пятен нет: кисть прозрачная, эллипсы остаются
         на месте и ничего не рисуют. -->
    <SolidColorBrush x:Key="Blob4" Color="Transparent"/>

    <LinearGradientBrush x:Key="WindowBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#1B1F27"/>
        <GradientStop Offset="0.55" Color="#232833"/>
        <GradientStop Offset="1" Color="#191D25"/>
    </LinearGradientBrush>
</ResourceDictionary>
