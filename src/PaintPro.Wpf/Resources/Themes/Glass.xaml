<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      «Стеклянная» - как было: цветные пятна за стеклом.

      Тема - это НАБОР ТЕХ ЖЕ КЛЮЧЕЙ. Всё оформление ходит через них, поэтому смена темы
      сводится к подмене этого словаря; ключи обязаны совпадать во всех темах до одного,
      иначе на смене приложение останется без кисти и упадёт при первой же отрисовке.

      Обращаться к ним надо через DynamicResource: StaticResource разрешается один раз
      при загрузке и подмену словаря не заметит.

      Отдельно стоят Overlay* - подложка того, что всплывает НАД ХОЛСТОМ (подсказки,
      выпадающие списки). Холст белый в любой теме, поэтому такая подложка в любой теме
      тёмная. Стеклянные кисти сюда не годятся: над белым они белеют, и светлый текст на
      них пропадает начисто - это уже случалось с выпадающим меню (1.23.0).
    -->

    <SolidColorBrush x:Key="Accent"            Color="#5B8DEF"/>
    <SolidColorBrush x:Key="Accent2"           Color="#9D5BEF"/>

    <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#5B8DEF"/>
        <GradientStop Offset="1" Color="#9D5BEF"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TextPrimary"       Color="#F4F4F8"/>
    <SolidColorBrush x:Key="TextDim"           Color="#9EA0AE"/>
    <SolidColorBrush x:Key="MenuBg"            Color="#241C3A"/>

    <!-- Подложка над холстом и её текст: темам не подчиняются по смыслу, см. оговорку выше. -->
    <SolidColorBrush x:Key="OverlayBg"         Color="#F21A142C"/>
    <SolidColorBrush x:Key="OverlayText"       Color="#F4F4F8"/>

    <!-- Опорный цвет фона: сплошной, под градиентом. По нему меряется контраст текста. -->
    <SolidColorBrush x:Key="AppBase"           Color="#12101F"/>

    <SolidColorBrush x:Key="GlassBg"           Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="GlassBgStrong"     Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="GlassBgHover"      Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="GlassBorder"       Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="GlassBorderStrong" Color="#55FFFFFF"/>

    <RadialGradientBrush x:Key="Blob1">
        <GradientStop Offset="0" Color="#9D5BFF"/>
        <GradientStop Offset="1" Color="#009D5BFF"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Blob2">
        <GradientStop Offset="0" Color="#FF64B4"/>
        <GradientStop Offset="1" Color="#00FF64B4"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Blob3">
        <GradientStop Offset="0" Color="#3CC8FF"/>
        <GradientStop Offset="1" Color="#003CC8FF"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Blob4">
        <GradientStop Offset="0" Color="#64FFB4"/>
        <GradientStop Offset="1" Color="#0064FFB4"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="WindowBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#0E0C1A"/>
        <GradientStop Offset="0.5" Color="#1A1330"/>
        <GradientStop Offset="1" Color="#0C1024"/>
    </LinearGradientBrush>
</ResourceDictionary>
